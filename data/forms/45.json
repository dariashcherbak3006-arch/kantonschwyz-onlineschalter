  {
   "title": "Angaben zum Hund",
   "fields": [
    {
     "name": "f19",
     "label": "Name",
     "required": true,
     "type": "text"
    },
    {
     "name": "f20",
     "label": "Rasse",
     "required": true,
     "type": "text"
    },
    {
     "name": "f31",
     "label": "Übernahmedatum des Hundes",
     "required": true,
     "type": "date"
    },
    {
     "name": "f21",
     "label": "Mikrochip-Nummer",
     "required": true,
     "type": "text",
     "pattern": "^\\d{15}$",
     "patternMessage": "Geben Sie die 15-stellige Chipnummer ohne Abstände im Format 123456789012345 ein.",
     "inputMode": "numeric"
    },
    {
     "name": "f25",
     "label": "Handelt es sich um einen Nutz- oder Arbeitshund?",
     "required": true,
     "hint": "Nutzhund = Treibhunde in der Landwirtschaft, Jagdhunde gemäss § 33 Abs. 1 des Jagd. und Wildschutzgesetzes vom 25.05.16 (JWG) Herdenschutzhunde / Arbeitshund = Armeehunde, Polizeihunde, Rettungs-, Katastrophen-, und Lawinenhunde, Schweisshunde, Blinden- und Assistenzhunde",
     "type": "radio",
     "options": [
      "Nein",
      "Ja, es handelt sich um einen Nutzhund",
      "Ja, es handelt sich um einen Arbeitshund"
     ]
    },
    {
     "name": "f26",
     "label": "Hundesteuer für Nutzhunde",
     "type": "info",
     "hidden": true,
     "rules": [
      {
       "attr": "hide",
       "value": false,
       "op": "=",
       "field": "f25",
       "eq": "Ja, es handelt sich um einen Nutzhund"
      },
      {
       "attr": "hide",
       "value": true,
       "op": "=",
       "field": "f25",
       "eq": "Nein"
      },
      {
       "attr": "hide",
       "value": true,
       "op": "=",
       "field": "f25",
       "eq": "Ja, es handelt sich um einen Arbeitshund"
      }
     ]
    },
    {
     "name": "f27",
     "label": "Nachweis Nutzhund für reduzierte Steuer",
     "hidden": true,
     "rules": [
      {
       "attr": "hide",
       "value": false,
       "op": "=",
       "field": "f25",
       "eq": "Ja, es handelt sich um einen Nutzhund"
      },
      {
       "attr": "hide",
       "value": true,
       "op": "=",
       "field": "f25",
       "eq": "Nein"
      },
      {
       "attr": "hide",
       "value": true,
       "op": "=",
       "field": "f25",
       "eq": "Ja, es handelt sich um einen Arbeitshund"
      }
     ],
     "hint": "Für Nutzhunde gelten tiefere Steuertarife als für normale Hunde. Laden Sie hier den Nachweis hoch, um zu belegen, dass es sich um einen Nutzhund handelt. Falls Sie keinen Nachweis besitzen, können Sie die Steuerreduktion separat beantragen, sobald Sie den Nachweis organisiert haben.",
     "type": "file"
    },
    {
     "name": "f28",
     "label": "Hundesteuer Arbeitshunde",
     "type": "info",
     "hidden": true,
     "rules": [
