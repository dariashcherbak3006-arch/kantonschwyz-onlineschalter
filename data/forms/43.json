  {
   "title": "Personalien",
   "fields": [
    {
     "name": "f35",
     "label": "Anrede",
     "required": true,
     "type": "radio",
     "options": [
      "Herr",
      "Frau"
     ]
    },
    {
     "name": "f2",
     "label": "Name",
     "required": true,
     "type": "text",
     "pattern": "^[a-zA-ZäöüÄÖÜßàáâãäåæçèéêëìíîïðñòóôõøùúûüýÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÑÒÓÔÕØÙÚÛÜÝ' -]+$",
     "patternMessage": "Bitte verwenden Sie keine Zahlen oder Sonderzeichen"
    },
    {
     "name": "f3",
     "label": "Vorname",
     "required": true,
     "type": "text",
     "pattern": "^[a-zA-ZäöüÄÖÜßàáâãäåæçèéêëìíîïðñòóôõøùúûüýÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÑÒÓÔÕØÙÚÛÜÝ' -]+$",
