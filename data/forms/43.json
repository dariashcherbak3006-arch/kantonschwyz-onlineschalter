     "required": true,
     "type": "date"
    },
    {
     "name": "f30_vorwahl",
     "label": "Vorwahl",
     "type": "select",
     "required": true,
     "span": 3,
     "options": [
      "+41",
      "+423",
      "+49",
      "+43",
      "+39",
      "+33"
     ],
     "default": "+41"
    },
    {
     "name": "f30",
     "label": "Telefon",
     "type": "tel",
     "required": true,
     "span": 9,
     "inputMode": "tel",
     "pattern": "^[0-9 ]{6,15}$",
     "patternMessage": "Bitte geben Sie eine gültige Telefonnummer ein."
    },
    {
     "name": "f23",
     "label": "E-Mail",
     "required": true,
     "type": "email",
     "inputMode": "email"
    }
   ]
  },
