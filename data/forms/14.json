     ]
    }
   ]
  },
  {
   "title": "Absender (abweichend)",
   "fields": [
    {
     "name": "step2_absender.name",
     "label": "Name",
     "required": true,
     "type": "text"
    },
    {
     "name": "step2_absender.vorname",
     "label": "Vorname",
     "required": true,
     "type": "text"
    },
    {
     "name": "step2_absender.firma",
     "label": "Firma",
     "type": "text"
    },
    {
     "name": "step2_absender.adresse",
     "label": "Adresse",
     "required": true,
     "type": "text"
    },
    {
     "name": "step2_absender.plz",
     "label": "PLZ",
     "required": true,
     "type": "text",
     "pattern": "^[0-9]{4}$",
     "inputMode": "numeric",
     "patternMessage": "Bitte 4 Ziffern eingeben.",
     "span": 4
    },
    {
     "name": "step2_absender.ort",
     "label": "Ort",
     "required": true,
     "type": "text"
    },
    {
     "name": "step2_absender.begruendung_stellvertretung",
     "label": "Begründung für Stellvertretung",
     "required": true,
     "type": "textarea"
    },
    {
     "name": "step2_absender.email",
     "label": "E-Mail",
     "required": true,
     "type": "email",
     "inputMode": "email"
    },
    {
     "name": "step2_absender.telefon",
     "label": "Telefon",
     "required": true,
     "placeholder": "+41 …",
     "type": "tel",
     "inputMode": "tel",
     "pattern": "^\\+?[0-9 ]{6,18}$",
     "patternMessage": "Bitte geben Sie eine gültige Telefonnummer ein."
    }
   ],
   "rules": [
    {
     "attr": "hide",
     "value": true,
     "op": "=",
     "field": "step1_personalien.abweichender_absender",
     "eq": "ja"
    }
   ]
  },
  {
   "title": "Ratenzahlung",
   "fields": [
    {
     "name": "step3_ratenzahlung.datum_rechnung",
     "label": "Datum der Rechnung",
     "required": true,
     "type": "date",
     "max": "today"
    },
    {
     "name": "step3_ratenzahlung.betrag",
     "label": "Betrag laut Rechnung",
     "required": true,
     "type": "number"
    },
    {
     "name": "step3_ratenzahlung.monatliche_rate",
     "label": "Monatliche Rate",
     "required": true,
     "type": "number"
    },
    {
     "name": "step3_ratenzahlung.faelligkeit_erstrate",
     "label": "Fälligkeit der ersten Rate",
     "required": true,
     "hint": "Das gewählte Datum darf höchstens 90 Tage in der Zukunft liegen.",
     "type": "date",
     "min": "today",
     "max": "today+90"
    },
    {
     "name": "step3_ratenzahlung.begruendung",
     "label": "Begründung",
     "required": true,
     "type": "textarea"
    },
    {
     "name": "step3_ratenzahlung.einzahlungsschein",
     "label": "Ich wünsche die Einzahlungsscheine wie folgt",
     "required": true,
     "placeholder": "Bitte auswählen...",
     "type": "select",
     "options": [
      "Einzahlungsschein per E-Mail",
      "ein Einzahlungsschein per Post",
      "alle Einzahlungsscheine per Post"
     ]
    }
   ]
  }
 ]
